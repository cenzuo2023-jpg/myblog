---
import Layout from '../../layouts/Layout.astro';
import { getPostsByTag } from '../../lib/craft';
import { format } from 'date-fns';

Astro.response.headers.set('Netlify-CDN-Cache-Control', 'public, durable, s-maxage=60, stale-while-revalidate=600');

const { tag } = Astro.params;

let posts: import('../../lib/craft').Post[] = [];
let error: string | null = null;

try {
  posts = await getPostsByTag(tag as string);
} catch (e: any) {
  error = e.message;
}
---

<Layout title={`标签: ${tag}`}>
  <div class="tag-header">
    <h1><span class="label">标签:</span> {tag}</h1>
    <p>共 {posts.length} 篇文章</p>
  </div>
  
  {error && (
    <div class="error-box">
      ⚠️ 获取该标签文章失败: {error}
    </div>
  )}

  <ul class="post-list">
    {posts.map(post => (
      <li>
        <a href={`/posts/${post.slug}`} class="post-title">{post.title}</a>
        <span class="post-meta">{post.publishDate ? format(new Date(post.publishDate), 'yyyy-MM-dd') : ''}</span>
      </li>
    ))}
  </ul>
</Layout>

<style>
  .tag-header {
    margin-bottom: 40px;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 20px;
  }
  h1 {
    font-size: 2rem;
    margin-bottom: 10px;
  }
  .label {
    color: var(--color-meta);
    font-weight: normal;
    font-size: 1.5rem;
  }
  p {
    color: var(--color-meta);
    margin: 0;
  }
  
  .post-list {
    list-style: none;
    padding: 0;
  }
  .post-list li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 15px 0;
    border-bottom: 1px dashed var(--color-border);
  }
  .post-title {
    font-size: 1.1rem;
    font-weight: 500;
  }
  .post-meta {
    font-size: 0.9rem;
    color: var(--color-meta);
  }
  
  @media (max-width: 600px) {
    .post-list li {
      flex-direction: column;
    }
    .post-meta {
      margin-top: 5px;
    }
  }
</style>
