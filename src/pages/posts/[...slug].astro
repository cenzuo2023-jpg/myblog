---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import Breadcrumbs from '../../components/content/Breadcrumbs.astro';
import PostMeta from '../../components/content/PostMeta.astro';
import PostLicense from '../../components/content/PostLicense.astro';
import PostNavigation from '../../components/content/PostNavigation.astro';
import RelatedPosts from '../../components/content/RelatedPosts.astro';
import { contentTypes } from '../../config/content';
import { getLocalePath } from '../../config/i18n';
import { siteConfig } from '../../config/site';
import { adjacentEntries, getLocalizedEntries, relatedPosts } from '../../lib/content/entries';
import { getPublishedPosts } from '../../lib/craft';
import { renderCraftBlocks } from '../../lib/craft/renderer';

const { slug } = Astro.params;
if (!slug) {
  return Astro.redirect('/404');
}

const rawPosts = await getPublishedPosts();
const post = rawPosts.find(p => p.slug === slug);

if (!post) {
  return Astro.redirect('/404');
}

// Convert Craft post to the CollectionEntry format expected by the theme
const entry = {
  id: post.slug,
  collection: 'posts',
  data: {
    title: post.title,
    description: post.summary,
    pubDate: new Date(post.publishDate),
    tags: post.tags,
    cover: post.coverImage,
    lang: 'zh-cn',
    draft: !post.published,
    featured: false,
    toc: 'center'
  }
} as any;

const posts = await getLocalizedEntries('posts', 'zh-cn');
const adjacent = adjacentEntries(posts, entry);
const related = relatedPosts(posts, entry, siteConfig.post.relatedCount);

const htmlContent = await renderCraftBlocks(post.content);

// Netlify cache control
Astro.response.headers.set('Netlify-CDN-Cache-Control', 'public, durable, s-maxage=60, stale-while-revalidate=600');
---

<BaseLayout title={entry.data.title} description={entry.data.description} locale="zh-cn" toc={entry.data.toc ?? 'center'} comments={entry.data.comments}>
  <Breadcrumbs
    locale="zh-cn"
    items={[
      { label: siteConfig.shortName, href: getLocalePath('zh-cn', '/'), icon: 'lucide:home' },
      { label: contentTypes.posts.label['zh-cn'] || 'Posts', href: getLocalePath('zh-cn', contentTypes.posts.path), icon: contentTypes.posts.icon },
      { label: entry.data.title, icon: 'lucide:file-text' }
    ]}
  />
  {entry.data.cover && (
    <div class="mb-8 overflow-hidden rounded-[var(--radius-card)]">
      <img src={entry.data.cover} alt={entry.data.title} class="aspect-video max-h-[60vh] w-full object-cover" loading="eager" />
    </div>
  )}
  <PostMeta
    title={entry.data.title}
    description={entry.data.description}
    date={entry.data.pubDate}
    locale="zh-cn"
    categories={entry.data.categories}
    tags={entry.data.tags}
  />
  <article class="prose mb-12 max-w-none craft-content" set:html={htmlContent}></article>
  <PostLicense locale="zh-cn" />
  <PostNavigation previous={adjacent.previous} next={adjacent.next} locale="zh-cn" kind="post" />
  <RelatedPosts posts={related} locale="zh-cn" />
</BaseLayout>
