---
import Layout from '../../layouts/Layout.astro';
import { getPostBySlug, getAdjacentPosts, renderCraftBlocks } from '../../lib/craft';
import { format } from 'date-fns';

Astro.response.headers.set('Netlify-CDN-Cache-Control', 'public, durable, s-maxage=60, stale-while-revalidate=600');

const { slug } = Astro.params;

let post: import('../../lib/craft').Post | undefined | null = null;
let adjacent: { prev: import('../../lib/craft').Post | null, next: import('../../lib/craft').Post | null } = { prev: null, next: null };
let htmlContent = '';
let error: string | null = null;

try {
  post = await getPostBySlug(slug as string);
  if (post) {
    adjacent = await getAdjacentPosts(post.slug);
    htmlContent = await renderCraftBlocks(post.content);
  }
} catch (e: any) {
  error = e.message;
}

if (!post && !error) {
  // If not found, Astro will render this as 404 if we return a 404 status
  Astro.response.status = 404;
}
---

{(!post && !error) ? (
  <Layout title="404 - 文章未找到">
    <div class="error-box">抱歉，未找到该文章。</div>
  </Layout>
) : (
  <Layout title={post?.title || '文章加载错误'} description={post?.summary}>
    {error && (
      <div class="error-box">
        ⚠️ 加载文章失败: {error}
      </div>
    )}

    {post && (
      <article>
        <header class="post-header">
          <h1>{post.title}</h1>
          <div class="post-meta-info">
            {post.publishDate && <span>发布于 {format(new Date(post.publishDate), 'yyyy-MM-dd')}</span>}
            {post.tags && post.tags.length > 0 && (
              <span class="tags">
                {post.tags.map(tag => (
                  <a href={`/tags/${tag}`} class="tag">#{tag}</a>
                ))}
              </span>
            )}
          </div>
          {post.coverImage && (
            <img src={post.coverImage} alt={post.title} class="cover-image" />
          )}
          {post.summary && (
            <div class="summary">
              {post.summary}
            </div>
          )}
        </header>

        <div class="craft-content" set:html={htmlContent} />

        <footer class="post-footer">
          <div class="share-actions">
            <!-- Share URL -->
            <button onclick="navigator.clipboard.writeText(window.location.href).then(() => alert('链接已复制！'))" class="share-btn">复制链接</button>
          </div>
          
          <nav class="adjacent-posts">
            {adjacent.prev ? (
              <a href={`/posts/${adjacent.prev.slug}`} class="prev-post">
                <span class="nav-label">上一篇</span>
                <span class="nav-title">{adjacent.prev.title}</span>
              </a>
            ) : <span class="empty-nav"></span>}
            
            {adjacent.next ? (
              <a href={`/posts/${adjacent.next.slug}`} class="next-post">
                <span class="nav-label">下一篇</span>
                <span class="nav-title">{adjacent.next.title}</span>
              </a>
            ) : <span class="empty-nav"></span>}
          </nav>
          
          <div class="back-link">
            <a href="/">← 返回首页</a>
          </div>
        </footer>
      </article>
    )}
  </Layout>
)}

<style>
  .post-header {
    margin-bottom: 40px;
  }
  .post-header h1 {
    font-size: 2.5rem;
    line-height: 1.3;
    margin-bottom: 15px;
  }
  .post-meta-info {
    color: var(--color-meta);
    font-size: 0.95rem;
    display: flex;
    gap: 15px;
    align-items: center;
    flex-wrap: wrap;
    margin-bottom: 25px;
  }
  .tags {
    display: flex;
    gap: 10px;
  }
  .cover-image {
    width: 100%;
    height: auto;
    border-radius: 8px;
    margin-bottom: 30px;
  }
  .summary {
    font-size: 1.15rem;
    color: var(--color-meta);
    padding: 15px 20px;
    background: var(--color-border);
    border-radius: 6px;
    margin-bottom: 40px;
    border-left: 4px solid var(--color-primary);
  }

  .post-footer {
    margin-top: 60px;
    padding-top: 40px;
    border-top: 1px solid var(--color-border);
  }

  .share-actions {
    margin-bottom: 40px;
    text-align: center;
  }
  .share-btn {
    background: transparent;
    border: 1px solid var(--color-border);
    padding: 8px 16px;
    border-radius: 4px;
    cursor: pointer;
    font-size: 0.9rem;
    color: var(--color-text);
    transition: all 0.2s;
  }
  .share-btn:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .adjacent-posts {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 40px;
  }
  .prev-post, .next-post {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 15px;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    text-decoration: none;
    transition: border-color 0.2s;
  }
  .prev-post:hover, .next-post:hover {
    border-color: var(--color-primary);
  }
  .next-post {
    text-align: right;
  }
  .nav-label {
    font-size: 0.8rem;
    color: var(--color-meta);
    margin-bottom: 5px;
  }
  .nav-title {
    font-size: 1rem;
    color: var(--color-text);
    font-weight: 500;
  }
  .empty-nav {
    flex: 1;
  }

  .back-link {
    text-align: center;
  }
</style>
