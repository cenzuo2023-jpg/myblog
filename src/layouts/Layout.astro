---
interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const siteName = import.meta.env.SITE_NAME || '我的个人博客';
const siteDesc = import.meta.env.SITE_DESCRIPTION || '个人实践与记录';
const finalTitle = title === siteName ? title : `${title} | ${siteName}`;
const finalDesc = description || siteDesc;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={finalDesc} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{finalTitle}</title>
    
    <!-- Open Graph / Twitter Card (Simple) -->
    <meta property="og:title" content={finalTitle} />
    <meta property="og:description" content={finalDesc} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={finalTitle} />
    <meta name="twitter:description" content={finalDesc} />
    <style is:global>
      :root {
        --color-bg: #FCFBF9; /* 淡奶油背景 */
        --color-text: #2A2A28; /* 墨黑深棕文字 */
        --color-primary: #C55D46; /* 低饱和强调色 (砖红) */
        --color-border: #E8E5E1;
        --color-meta: #8C8881;
        
        --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, 'Noto Sans', sans-serif, 'Apple Color Emoji', 'Segoe UI Emoji', 'Segoe UI Symbol', 'Noto Color Emoji';
        --font-serif: 'Noto Serif SC', 'Songti SC', 'STSong', serif;
      }
      
      * {
        box-sizing: border-box;
      }

      html, body {
        margin: 0;
        padding: 0;
        background-color: var(--color-bg);
        color: var(--color-text);
        font-family: var(--font-sans);
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      a {
        color: var(--color-primary);
        text-decoration: none;
        transition: opacity 0.2s;
      }
      a:hover {
        opacity: 0.8;
      }

      .container {
        max-width: 800px; /* 适合中文长文阅读的宽度 */
        margin: 0 auto;
        padding: 0 20px;
      }

      header {
        padding: 40px 0;
        border-bottom: 1px solid var(--color-border);
        margin-bottom: 40px;
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        flex-wrap: wrap;
        gap: 20px;
      }

      .site-title {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--color-text);
        letter-spacing: 0.05em;
      }

      nav {
        display: flex;
        gap: 20px;
      }

      nav a {
        color: var(--color-text);
        font-size: 0.95rem;
      }

      nav a:hover {
        color: var(--color-primary);
      }

      footer {
        margin-top: 80px;
        padding: 40px 0;
        border-top: 1px solid var(--color-border);
        text-align: center;
        color: var(--color-meta);
        font-size: 0.85rem;
      }

      /* Craft Content Styles */
      .craft-content {
        font-family: var(--font-serif);
        font-size: 1.1rem;
        line-height: 1.8;
      }
      .craft-content h1,
      .craft-content h2,
      .craft-content h3 {
        font-family: var(--font-sans);
        color: var(--color-text);
        margin-top: 2em;
        margin-bottom: 1em;
      }
      .craft-content h2 { font-size: 1.7rem; }
      .craft-content h3 { font-size: 1.3rem; }
      
      .craft-content img {
        max-width: 100%;
        height: auto;
        border-radius: 4px;
        margin: 20px 0;
      }
      
      .craft-content blockquote {
        margin: 0;
        padding: 10px 20px;
        border-left: 4px solid var(--color-border);
        color: var(--color-meta);
        font-style: italic;
      }
      
      .craft-content pre {
        background-color: #f0ede8;
        padding: 20px;
        border-radius: 4px;
        overflow-x: auto;
        font-family: monospace;
        font-size: 0.9rem;
      }
      
      .craft-content p {
        margin-bottom: 1.5em;
      }

      .post-meta {
        font-size: 0.9rem;
        color: var(--color-meta);
        margin-bottom: 30px;
      }
      .tag {
        display: inline-block;
        background: var(--color-border);
        padding: 2px 8px;
        border-radius: 4px;
        font-size: 0.8rem;
        margin-right: 8px;
        color: var(--color-text);
      }

      /* Error Box */
      .error-box {
        padding: 20px;
        background-color: #fee;
        color: #c00;
        border-radius: 4px;
        margin-bottom: 20px;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <header>
        <a href="/" class="site-title">{siteName}</a>
        <nav>
          <a href="/">首页</a>
          <a href="/archive">归档</a>
          <a href="/tags">标签</a>
          <a href="/about">关于</a>
        </nav>
      </header>
      
      <main>
        <slot />
      </main>

      <footer>
        &copy; {new Date().getFullYear()} {siteName}. All rights reserved.
      </footer>
    </div>
  </body>
</html>
